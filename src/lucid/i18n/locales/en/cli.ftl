### CLI help text and operator-facing messages.

cli-app-help = Spotlight-style desktop assistant.
cli-version = lucid { $version }

# Subcommand summaries
cli-cmd-run = Launch the overlay daemon (default if no command given).
cli-cmd-exec = Run an Execute task headless and stream progress.
cli-cmd-teach = Manage Teach-mode workflows (record, list, show, run, delete).
cli-cmd-schedule = Manage scheduled tasks (cron, one-shot, every-N).
cli-cmd-memory = Inspect or prune long-term memory.
cli-cmd-config = Read or write configuration values.
cli-cmd-doctor = Run a self-diagnostic for common install issues.
cli-cmd-version = Print the Lucid version and exit.

# Doctor output
doctor-header = Lucid self-diagnostic
doctor-ok = OK
doctor-warn = Warning
doctor-fail = Failed
doctor-check-api-key = API key configured
doctor-check-hotkey = Hotkey not in use by another app
doctor-check-dpi = Display scaling detected
doctor-check-permissions = Required permissions granted
doctor-check-model = Backend can reach the configured model
doctor-summary-pass = All checks passed.
doctor-summary-fail = One or more checks failed. See messages above.

# Generic
cli-error-prefix = error:
cli-success = Done.
