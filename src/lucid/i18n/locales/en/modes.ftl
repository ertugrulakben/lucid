### Mode-specific user-facing strings (Answer / Teach / Execute)

# Answer mode
answer-thinking = Thinking...
answer-no-context = No active window detected. Lucid will use the screen only.
answer-result-copied = Answer copied to clipboard.

# Teach mode
teach-record-start = Recording started. Perform the steps you want Lucid to learn.
teach-record-stop = Recording stopped.
teach-record-saving = Saving workflow...
teach-record-empty = Nothing was recorded. The workflow was discarded.
teach-replay-start = Replaying workflow: { $name }
teach-replay-step = Step { $current } of { $total }: { $description }
teach-replay-done = Workflow finished.
teach-replay-failed = Workflow stopped at step { $step }: { $reason }

# Execute mode
execute-step-planning = Planning the next step...
execute-step-acting = Working: { $description }
execute-step-verified = Verified.
execute-step-blocked = Blocked: { $reason }
execute-done = Task finished.
execute-stopped = Stopped by user.
execute-budget-exceeded = Step budget exceeded ({ $limit } steps). Stopping.
execute-timeout = Time budget exceeded ({ $seconds }s). Stopping.

# Shared
mode-switch-answer = Switched to Answer mode.
mode-switch-teach = Switched to Teach mode.
mode-switch-execute = Switched to Execute mode.
