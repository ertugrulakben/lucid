### CLI yardım metinleri ve operatör mesajları.

cli-app-help = Spotlight tarzı masaüstü asistanı.
cli-version = lucid { $version }

# Alt komut özetleri
cli-cmd-run = Overlay'i başlat (komut verilmezse varsayılan).
cli-cmd-exec = Yürüt görevini başsız çalıştır ve ilerlemeyi yayına ver.
cli-cmd-teach = Öğret iş akışlarını yönet (kaydet, listele, göster, oynat, sil).
cli-cmd-schedule = Zamanlanmış görevleri yönet (cron, tek seferlik, her N).
cli-cmd-memory = Uzun süreli hafızayı incele veya temizle.
cli-cmd-config = Yapılandırma değerlerini oku veya yaz.
cli-cmd-doctor = Yaygın kurulum sorunları için kendi kendine tanı yap.
cli-cmd-version = Lucid sürümünü yazdır ve çık.

# Doctor çıktısı
doctor-header = Lucid kendi kendine tanı
doctor-ok = Tamam
doctor-warn = Uyarı
doctor-fail = Başarısız
doctor-check-api-key = API anahtarı tanımlı
doctor-check-hotkey = Kısayol başka bir uygulamada kullanımda değil
doctor-check-dpi = Ekran ölçeklemesi algılandı
doctor-check-permissions = Gerekli izinler verildi
doctor-check-model = Backend yapılandırılan modele ulaşabiliyor
doctor-summary-pass = Tüm kontroller geçti.
doctor-summary-fail = Bir veya daha fazla kontrol başarısız. Yukarıdaki mesajlara bakın.

# Genel
cli-error-prefix = hata:
cli-success = Tamam.
